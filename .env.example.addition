# ============================================
# ADD THESE TO YOUR .env FILE
# ============================================

# Super Admin Auto-Registration
# These credentials will be used to create the Super Admin on server startup
SUPER_ADMIN_EMAIL=superadmin@luxxage.com
SUPER_ADMIN_PASSWORD=SuperSecurePassword123!
SUPER_ADMIN_NAME=Super Administrator

# Frontend URL
# Used in OTP emails to generate verification links
FRONTEND_URL=http://localhost:3000

# ============================================
# MAKE SURE THESE EXISTING VARIABLES ARE SET
# ============================================

# JWT Configuration
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRATION=24h

# Mail Configuration
# MAIL_TRANSPORT=SMTP or AZURE
# (Your existing mail config should already be set)
